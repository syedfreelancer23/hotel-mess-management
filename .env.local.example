# Supabase Configuration
# Get these from your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Optional: Set this to your production domain for OAuth redirects
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: OAuth provider to use for sign in (default: github)
# Example values: github, google, gitlab, discord
# NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDER=github
